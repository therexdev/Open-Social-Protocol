{
  "name": "@osp/sponsor",
  "version": "0.1.0",
  "private": true,
  "description": "Open Social Protocol Mana sponsor: a replaceable payer service with method allowlists, per-user quotas, discovery metadata and utilization reporting",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node --experimental-sqlite dist/main.js",
    "dev": "node --experimental-sqlite --import tsx src/main.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@osp/proto": "0.1.0",
    "@osp/sdk": "0.1.0",
    "fastify": "^5.0.0",
    "koilib": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
