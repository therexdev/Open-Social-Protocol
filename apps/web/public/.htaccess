# Open Social Protocol web client - single page application rewrite (Apache / LiteSpeed).
# Every path that is not an existing file or directory is served by index.html so that
# deep links such as /post/<id> or /u/<account> work after a reload.
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Hashed assets can be cached for a long time; index.html must not be.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
