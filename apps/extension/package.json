{
  "name": "@osp/extension",
  "version": "0.7.1",
  "private": true,
  "description": "Open Social Protocol standalone Chrome client with optional Facebook and X feed integration and cross-posting",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/build-content.mjs && node scripts/build-release.mjs && node scripts/smoke-dist.mjs",
    "smoke": "node scripts/smoke-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "zip": "node scripts/zip.mjs",
    "clean": "rm -rf dist dist.zip",
    "smoke:browser": "node scripts/smoke-client-browser.mjs",
    "smoke:client-browser": "node scripts/smoke-client-browser.mjs",
    "smoke:facebook-scroll": "node scripts/smoke-facebook-scroll.mjs",
    "smoke:embed-browser": "node scripts/smoke-embed-browser.mjs",
    "smoke:facebook-post": "node scripts/smoke-facebook-post.mjs",
    "smoke:x-feed": "node scripts/smoke-x-feed.mjs",
    "smoke:x-post": "node scripts/smoke-x-post.mjs",
    "smoke:x-draft": "node scripts/smoke-x-draft.mjs"
  },
  "dependencies": {
    "@osp/proto": "0.1.0",
    "@osp/sdk": "0.1.0",
    "koilib": "^9.4.0",
    "protobufjs": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@types/chrome": "^0.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
