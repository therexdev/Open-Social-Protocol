{
  "name": "@osp/sdk",
  "version": "0.1.0",
  "description": "Open Social Protocol TypeScript SDK: canonical encoding, signing, encryption, protocol client, sponsor client, reconciliation and conformance vectors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vectors": "node --import tsx scripts/generate-vectors.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@osp/proto": "0.1.0",
    "@scure/base": "^2.0.0",
    "koilib": "^9.4.0",
    "protobufjs": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
